    {
      "parameters": {
        "jsCode": "const results = $input.all();\n\nconst posted_to = [];\nconst failed = [];\n\nfor (const result of results) {\n  if (result.json.success) {\n    posted_to.push(result.json.platform);\n  } else {\n    failed.push({\n      platform: result.json.platform,\n      error: result.json.error_message\n    });\n  }\n}\n\nconst request_id = `${new Date().toISOString()}-${$execution.id}`;\nconst timestamp = new Date().toISOString();\n\nreturn [\n  {\n    json: {\n      status: 'completed',\n      posted_to: posted_to,\n      failed: failed,\n      total_requested: results.length,\n      successful: posted_to.length,\n      failed_count: failed.length,\n      request_id: request_id,\n      timestamp: timestamp\n    }\n  }\n];"
      },
