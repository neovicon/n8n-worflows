{
  "name": "Multi-Platform Social Media Posting Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "social-post-agent",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "social-post-agent"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.text }}",
              "operation": "isNotEmpty"
            }
          ],
          "array": [
            {
              "value1": "={{ $json.body.platforms }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "input-validation",
      "name": "Input Validation",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "error"
            },
            {
              "name": "message",
              "value": "Missing required fields: text and platforms are required"
            },
            {
              "name": "request_id",
              "value": "={{ $now.toISO() }}-{{ $runIndex }}"
            }
          ]
        },
        "options": {}
      },
      "id": "validation-error",
      "name": "Validation Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [680, 480]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "text",
              "value": "={{ $json.body.text }}"
            },
            {
              "name": "image",
              "value": "={{ $json.body.image || '' }}"
            },
            {
              "name": "twitter_text",
              "value": "={{ $json.body.text.length > 280 ? $json.body.text.slice(0, 277) + '...' : $json.body.text }}"
            },
            {
              "name": "facebook_text",
              "value": "={{ $json.body.text }}"
            },
            {
              "name": "linkedin_text",
              "value": "={{ $json.body.text }}"
            },
            {
              "name": "instagram_text",
              "value": "={{ $json.body.text + '\\n\\n#socialmedia #automation' }}"
            },
            {
              "name": "telegram_text",
              "value": "={{ $json.body.text }}"
            },
            {
              "name": "request_id",
              "value": "={{ $now.toISO() }}-{{ $runIndex }}"
            },
            {
              "name": "timestamp",
              "value": "={{ $now.toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "content-formatter",
      "name": "Content Formatter",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [680, 120]
    },
    {
      "parameters": {
        "functionCode": "const platforms = $input.first().json.body.platforms;\nconst baseData = $input.first().json;\n\nconst items = platforms.map(platform => ({\n  json: {\n    ...baseData,\n    platform: platform\n  }\n}));\n\nreturn items;"
      },
      "id": "split-platforms",
      "name": "Split Platforms",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [900, 120]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.platform }}",
        "rules": {
          "rules": [
            {
              "value2": "twitter",
              "output": 0
            },
            {
              "value2": "facebook",
              "output": 1
            },
            {
              "value2": "linkedin",
              "output": 2
            },
            {
              "value2": "instagram",
              "output": 3
            },
            {
              "value2": "telegram",
              "output": 4
            }
          ]
        }
      },
      "id": "platform-router",
      "name": "Platform Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [1120, 120]
    },
    {
      "parameters": {
        "text": "={{ $json.twitter_text }}",
        "additionalFields": {}
      },
      "id": "post-to-twitter",
      "name": "Post to Twitter",
      "type": "n8n-nodes-base.twitter",
      "typeVersion": 1,
      "position": [1340, 0],
      "continueOnFail": true,
      "credentials": {
        "twitterOAuth1Api": {
          "id": "1",
          "name": "Twitter account"
        }
      }
    },
    {
