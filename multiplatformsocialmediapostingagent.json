    {
      "parameters": {
        "jsCode": "const results = $input.all();\n\nconst posted_to = [];\nconst failed = [];\n\nfor (const result of results) {\n  if (result.json.success) {\n    posted_to.push(result.json.platform);\n  } else {\n    failed.push(result.json.platform);\n  }\n}\n\nconst request_id = results[0]?.json.request_id || `${new Date().toISOString()}-${$execution.id}`;\nconst timestamp = results[0]?.json.timestamp || new Date().toISOString();\n\nreturn {\n  status: 'completed',\n  posted_to: posted_to,\n  failed: failed,\n  request_id: request_id,\n  timestamp: timestamp\n};"
      },
